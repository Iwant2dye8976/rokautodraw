{
  "manifest_version": 3,
  "name": "ROK Weekly Auto",
  "version": "1.1",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "alarms",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.lilithgame.com/*",
    "https://*.lilith.com/*",
    "https://store.lilith.com/*",
    "https://*.plutomall.com/*",
    "https://*.plutomall.com.vn/*",
    "https://passport.pup.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icons/icon16.png",
    "32": "images/icons/icon32.png",
    "48": "images/icons/icon48.png",
    "128": "images/icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icons/icon16.png",
      "32": "images/icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://q.lilithgame.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://passport-global.lilith.com/*",
        "https://passport.pup.vn/*"
      ],
      "js": [
        "relogin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}